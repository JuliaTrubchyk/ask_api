    {
      "name": "Sign in as Teacher",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const submittedEmail = \"Valln1938@gustr.com\";",
              "let response;",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.match(/^application\\/json\\b/i);",
              "});",
              "",
              "pm.test(\"Response time is under 2000 ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "pm.test(\"Response body is valid JSON\", function () {",
              "    pm.expect(function () {",
              "        response = pm.response.json();",
              "    }).not.to.throw();",
              "});",
              "",
              "if (response) {",
              "    pm.test(\"Response contains a user object and non-empty token string\", function () {",
              "        pm.expect(response).to.have.property(\"user\").that.is.an(\"object\");",
              "        pm.expect(response).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    });",
              "",
              "    pm.test(\"User role is TEACHER\", function () {",
              "        pm.expect(response.user).to.be.an(\"object\");",
              "        pm.expect(response.user.role).to.eql(\"TEACHER\");",
              "    });",
              "",
              "    pm.test(\"User email matches the submitted email case-insensitively\", function () {",
              "        pm.expect(response.user).to.be.an(\"object\");",
              "        pm.expect(response.user.email).to.be.a(\"string\");",
              "        pm.expect(response.user.email.toLowerCase()).to.eql(submittedEmail.toLowerCase());",
              "    });",
              "",
              "    if (typeof response.token === \"string\" && response.token.trim().length > 0) {",
              "        pm.environment.set(\"teacherToken\", response.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "packages": {},
            "type": "text/javascript"
