    {
      "name": "grade assignment as Teacher",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const assignmentId = Number(pm.environment.get(\"assignment_id\"));",
              "",
              "const assignment = response.find(item => item.id === assignmentId);",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Graded assignment exists in response\", function () {",
              "    pm.expect(assignment).to.exist;",
              "});",
              "",
              "pm.test(\"Assignment is graded\", function () {",
              "    pm.expect(assignment.status).to.eql(\"GRADED\");",
              "});",
              "",
              "pm.test(\"Result is PASSED\", function () {",
              "    pm.expect(assignment.result).to.eql(\"PASSED\");",
              "});",
              "",
              "pm.test(\"Assignment was graded by teacher\", function () {",
              "    pm.expect(assignment.gradedBy).to.eql(\"TEACHER\");",
              "});",
              "",
              "pm.test(\"Teacher score was saved\", function () {",
              "    pm.expect(assignment.additionalScores).to.include(5);",
              "});",
              "",
              "pm.test(\"Teacher comment was saved\", function () {",
              "    pm.expect(assignment.comments).to.include(\"Teacher comment\");",
              "});",
              "",
              "pm.test(\"Teacher summary was saved\", function () {",
              "    pm.expect(assignment.summary).to.eql(\"Summary from teacher\");",
              "});",
              "",
              "pm.test(\"Graded date is populated\", function () {",
              "    pm.expect(assignment.gradedAt).to.not.be.null;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
